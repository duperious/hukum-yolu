# Hüküm Yolu — istemci ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın ve kendi Supabase projenizin
# değerlerini girin. Supabase yapılandırılmazsa uygulama yalnızca
# yerel bot modunda çalışır.
#
# ÖNEMLİ: Service role anahtarını ASLA buraya koymayın. Edge Function
# ortamı SUPABASE_SERVICE_ROLE_KEY değerini Supabase'den otomatik alır.
#
# VITE_ ile başlayan değerler tarayıcı paketine gömülür; herkese açıktır.
# Anon/publishable anahtar tarayıcıda kullanılmak üzere tasarlanmıştır.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
